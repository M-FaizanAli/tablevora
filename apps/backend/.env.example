DATABASE_URL="postgresql://nodedr:nodedr_dev_pw@localhost:5432/nodedr_restaurant"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"
PORT=4001
CORS_ORIGIN="http://localhost:1995"

NODE_ENV=production
ENABLE_SWAGGER=false
DEMO_MODE=false
# Enable only on a separate client-facing deployment, never on the showcase.
